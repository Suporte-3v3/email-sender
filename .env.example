# Copie para /opt/meter-report/.env e rode `chmod 600 .env`.
# Linhas comentadas mostram o valor padrão.

# --- SSH (Pi do banco) ---
SSH_HOST=
# SSH_PORT=22
# SSH_USER=pi
# SSH_KEY_PATH=/secrets/id_ed25519
# SSH_KNOWN_HOSTS=/secrets/known_hosts

# --- MariaDB (endereço visto do servidor SSH) ---
# DB_ADDR=127.0.0.1:3306
DB_USER=relatorio
DB_PASSWORD=
# DB_NAME=LOG_SENSOR

# --- Relatório ---
TABLES=SEL-751-1,SFR_001_1,SFR_001_2,SFR_001_3
SENSOR_TYPE=
# Últimos N dias completos até ontem.
REPORT_DAYS=7
# Reprocessamento (ambos, inclusivos, AAAA-MM-DD); sobrescrevem REPORT_DAYS.
# REPORT_FROM=
# REPORT_TO=

# --- E-mail ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Endereços simples (a@b.com), sem nome de exibição.
MAIL_TO=
MAIL_CC=

TZ=America/Sao_Paulo
